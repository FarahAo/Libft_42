#include "libft.h"

void	ft_bzero(void *s, size_t n)
{
	unsigned char	*p;
	size_t			i;

	p = (unsigned char *)s;
	i = 0;
	while (n)
	{
		p[i] = 0;
		n--;
		i++;
	}
}
#include <stdio.h>
int main()
{
	char a[] = {'a', 'b'};
	int c[] = {1, 2, 3};
	ft_bzero(a, 1);
	 printf("%c %c", a[0], a[1]);
	ft_bzero(a, 2);
	printf("%c %c", a[0], a[1]);
	ft_bzero(c, 4);
	printf("%d %d %d ", c[0], c[1], c[2]);
	ft_bzero(c, 8);
	 printf("%d %d %d ", c[0], c[1], c[2]);


	


}
